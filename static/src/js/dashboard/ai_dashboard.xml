<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odoo_ai_ce.AiDashboard">
        <div class="o_ai_dashboard_container">
            <div class="o_ai_header d-flex justify-content-between align-items-center">
                <div>
                    <h1>AI Framework Control Center</h1>
                    <p>Real-time monitoring of AI providers, Hermes ACP sidecar supervisor, autonomous agents, and zero-trust governance.</p>
                </div>
                <div>
                    <button class="btn btn-outline-info me-2" t-on-click="loadDashboardData" t-att-disabled="state.isControlling">
                        <i class="fa fa-refresh me-1"/> Refresh
                    </button>
                    <button class="btn btn-primary" t-on-click="() => this.openAction('odoo_ai_ce.action_ai_ce_agent')">
                        <i class="fa fa-robot me-1"/> Manage Agents
                    </button>
                </div>
            </div>

            <!-- Top Metric Cards -->
            <div class="o_ai_metric_grid">
                <div class="o_ai_card cursor-pointer" t-on-click="() => this.openAction('odoo_ai_ce.action_ai_ce_provider')">
                    <div class="o_ai_card_title">Active AI Providers</div>
                    <div class="o_ai_card_value">
                        <t t-out="state.activeProviders"/> / <t t-out="state.providerCount"/>
                    </div>
                    <span class="o_ai_badge success">Connected</span>
                </div>

                <div class="o_ai_card cursor-pointer" t-on-click="() => this.openAction('odoo_ai_ce.action_ai_ce_model')">
                    <div class="o_ai_card_title">Catalogued Models</div>
                    <div class="o_ai_card_value"><t t-out="state.modelCount"/></div>
                    <span class="o_ai_badge success">LLM &amp; Embeddings</span>
                </div>

                <div class="o_ai_card cursor-pointer" t-on-click="() => this.openAction('odoo_ai_ce.action_ai_ce_tool')">
                    <div class="o_ai_card_title">Callable Tools</div>
                    <div class="o_ai_card_value"><t t-out="state.toolCount"/></div>
                    <span class="o_ai_badge success">ORM &amp; Custom Python</span>
                </div>

                <div class="o_ai_card cursor-pointer" t-on-click="() => this.openAction('odoo_ai_ce.action_ai_ce_consent')">
                    <div class="o_ai_card_title">Pending HITL Approvals</div>
                    <div class="o_ai_card_value"><t t-out="state.pendingConsents"/></div>
                    <span t-attf-class="o_ai_badge #{state.pendingConsents > 0 ? 'warning' : 'success'}">
                        <t t-out="state.pendingConsents > 0 ? 'Action Required' : 'All Clear'"/>
                    </span>
                </div>

                <div class="o_ai_card cursor-pointer" t-on-click="() => this.openAction('odoo_ai_ce.action_ai_ce_hermes_sidecar')">
                    <div class="o_ai_card_title">Hermes Agent Sidecar</div>
                    <div class="o_ai_card_value">
                        <t t-out="state.hermesStatus.is_running ? 'Online' : 'Standby'"/>
                    </div>
                    <span t-attf-class="o_ai_badge #{state.hermesStatus.is_running ? 'success' : 'warning'}">
                        Loopback IPC (127.0.0.1:8765)
                    </span>
                </div>
            </div>

            <!-- Hermes Supervisor & ACP Control Deck -->
            <div class="o_ai_section_card mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h3 class="mb-1">
                            <i class="fa fa-microchip text-primary me-2"/> Hermes Agent Supervisor &amp; ACP Monitor
                        </h3>
                        <p class="text-muted small mb-0">Local autonomous background supervisor with Agent Communication Protocol (ACP) and OpenAI-compatible completions.</p>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <button t-if="!state.hermesStatus.is_running" class="btn btn-sm btn-success" t-on-click="() => this.controlSupervisor('start')" t-att-disabled="state.isControlling">
                            <i class="fa fa-play me-1"/> Start Daemon
                        </button>
                        <button t-if="state.hermesStatus.is_running" class="btn btn-sm btn-warning" t-on-click="() => this.controlSupervisor('restart')" t-att-disabled="state.isControlling">
                            <i class="fa fa-refresh me-1"/> Restart
                        </button>
                        <button t-if="state.hermesStatus.is_running" class="btn btn-sm btn-danger" t-on-click="() => this.controlSupervisor('stop')" t-att-disabled="state.isControlling">
                            <i class="fa fa-stop me-1"/> Stop
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" t-on-click="() => this.controlSupervisor('ping')" t-att-disabled="state.isControlling">
                            <i class="fa fa-heartbeat me-1"/> Ping
                        </button>
                        <button class="btn btn-sm btn-outline-info" t-on-click="() => this.openAction('odoo_ai_ce.action_ai_ce_hermes_sidecar')">
                            <i class="fa fa-cog me-1"/> Configure
                        </button>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-3">
                        <div class="p-3 bg-dark rounded border border-secondary">
                            <div class="text-muted small text-uppercase">Daemon Status</div>
                            <div class="h5 mb-0 mt-1 d-flex align-items-center gap-2">
                                <i t-attf-class="fa fa-circle #{state.hermesStatus.is_running ? 'text-success' : 'text-danger'}"/>
                                <t t-out="state.hermesStatus.is_running ? 'RUNNING' : 'STOPPED'"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="p-3 bg-dark rounded border border-secondary">
                            <div class="text-muted small text-uppercase">Process PID &amp; Version</div>
                            <div class="h5 mb-0 mt-1">
                                PID: <span class="text-info"><t t-out="state.hermesStatus.process_pid || '-'"/></span>
                                <span class="text-muted small ms-2">(v<t t-out="state.hermesStatus.version || '19.0.2.0'"/>)</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="p-3 bg-dark rounded border border-secondary">
                            <div class="text-muted small text-uppercase">Memory / CPU</div>
                            <div class="h5 mb-0 mt-1">
                                <t t-out="state.hermesStatus.memory_mb ? state.hermesStatus.memory_mb.toFixed(1) + ' MB' : '-'"/>
                                <span class="text-muted small ms-2">(<t t-out="state.hermesStatus.cpu_percent ? state.hermesStatus.cpu_percent.toFixed(1) + '%' : '0%'"/> CPU)</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="p-3 bg-dark rounded border border-secondary">
                            <div class="text-muted small text-uppercase">Active ACP Sessions</div>
                            <div class="h5 mb-0 mt-1 text-primary">
                                <t t-out="state.hermesStatus.active_acp_sessions || 0"/> Concurrent Turns
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Provider Status Table -->
            <div class="o_ai_section_card mb-4">
                <h3>Connected AI Providers</h3>
                <div class="table-responsive">
                    <table class="table table-dark table-hover mb-0">
                        <thead>
                            <tr class="text-muted small text-uppercase">
                                <th>Provider</th>
                                <th>Service Engine</th>
                                <th>Priority</th>
                                <th>Status</th>
                                <th>Active</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="state.providersList" t-as="prov" t-key="prov.id">
                                <tr>
                                    <td class="fw-bold"><t t-out="prov.name"/></td>
                                    <td><t t-out="prov.service"/></td>
                                    <td><t t-out="prov.priority"/></td>
                                    <td>
                                        <span t-attf-class="badge #{prov.connection_status === 'connected' ? 'bg-success' : (prov.connection_status === 'error' ? 'bg-danger' : 'bg-secondary')}">
                                            <t t-out="prov.connection_status"/>
                                        </span>
                                    </td>
                                    <td>
                                        <i t-attf-class="fa #{prov.active ? 'fa-check-circle text-success' : 'fa-times-circle text-muted'}"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Recent Security Audit Logs -->
            <div class="o_ai_section_card">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="mb-0">Recent Security &amp; Execution Audit Trail</h3>
                    <button class="btn btn-sm btn-link text-info" t-on-click="() => this.openAction('odoo_ai_ce.action_ai_ce_log')">
                        View All Logs (<t t-out="state.totalLogs"/>)
                    </button>
                </div>
                <div class="table-responsive">
                    <table class="table table-dark table-hover mb-0">
                        <thead>
                            <tr class="text-muted small text-uppercase">
                                <th>Timestamp</th>
                                <th>User</th>
                                <th>Origin</th>
                                <th>Model</th>
                                <th>Latency (ms)</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="state.recentLogs" t-as="log" t-key="log.id">
                                <tr>
                                    <td class="small"><t t-out="log.timestamp"/></td>
                                    <td><t t-out="log.user_id ? log.user_id[1] : 'System'"/></td>
                                    <td><span class="badge bg-secondary"><t t-out="log.client_type"/></span></td>
                                    <td><t t-out="log.model_used || '-'"/></td>
                                    <td><t t-out="log.execution_time_ms ? log.execution_time_ms.toFixed(1) : '-'"/></td>
                                    <td>
                                        <span t-attf-class="badge #{log.status === 'success' ? 'bg-success' : (log.status === 'consent_blocked' ? 'bg-warning text-dark' : 'bg-danger')}">
                                            <t t-out="log.status"/>
                                        </span>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </t>
</templates>
