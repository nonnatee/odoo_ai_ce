<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ai_ce_resource_view_list" model="ir.ui.view">
        <field name="name">ai_ce.resource.list</field>
        <field name="model">ai_ce.resource</field>
        <field name="arch" type="xml">
            <list string="AI Resource Allowlist">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="model_name"/>
                <field name="uri"/>
                <field name="model_exists" widget="boolean_toggle"/>
                <field name="record_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="ai_ce_resource_view_form" model="ir.ui.view">
        <field name="name">ai_ce.resource.form</field>
        <field name="model">ai_ce.resource</field>
        <field name="arch" type="xml">
            <form string="AI Resource Configuration">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Sales Orders, Customers"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="model_name" placeholder="e.g. sale.order"/>
                            <field name="uri" readonly="1"/>
                        </group>
                        <group>
                            <field name="model_exists" readonly="1"/>
                            <field name="record_count" readonly="1"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Resource Description (Provided to Clients)">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ai_ce_resource" model="ir.actions.act_window">
        <field name="name">MCP Resource Allowlist</field>
        <field name="res_model">ai_ce.resource</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
