<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ai_ce_log_view_list" model="ir.ui.view">
        <field name="name">ai_ce.log.list</field>
        <field name="model">ai_ce.log</field>
        <field name="arch" type="xml">
            <list string="Security &amp; Execution Audit Logs" create="0" delete="0">
                <field name="timestamp"/>
                <field name="user_id"/>
                <field name="client_type" widget="badge"/>
                <field name="tool_id"/>
                <field name="model_used"/>
                <field name="execution_time_ms"/>
                <field name="status" widget="badge" decoration-success="status == 'success'" decoration-danger="status == 'error'" decoration-warning="status == 'consent_blocked'"/>
            </list>
        </field>
    </record>

    <record id="ai_ce_log_view_form" model="ir.ui.view">
        <field name="name">ai_ce.log.form</field>
        <field name="model">ai_ce.log</field>
        <field name="arch" type="xml">
            <form string="Audit Log Entry" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="timestamp"/>
                            <field name="user_id"/>
                            <field name="client_type"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="tool_id"/>
                            <field name="model_used"/>
                            <field name="execution_time_ms"/>
                        </group>
                    </group>
                    <group string="Input Payload Preview">
                        <field name="input_preview" nolabel="1"/>
                    </group>
                    <group string="Error Details" invisible="not error_message">
                        <field name="error_message" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ai_ce_log" model="ir.actions.act_window">
        <field name="name">Security Audit Logs</field>
        <field name="res_model">ai_ce.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
