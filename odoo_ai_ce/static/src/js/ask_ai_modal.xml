<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odoo_ai_ce.AskAiModal">
        <Dialog title="'Odoo AI Assistant (Ctrl+K)'" size="'lg'" contentClass="'o_ai_modal_dialog'">
            <div class="o_ai_chat_body">
                <t t-foreach="state.messages" t-as="msg" t-key="msg_index">
                    <div t-attf-class="o_ai_message o_ai_msg_#{msg.role}">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="fw-bold small text-uppercase">
                                <t t-out="msg.role === 'user' ? 'You' : (msg.role === 'tool' ? 'Tool Output' : 'AI Assistant')"/>
                            </span>
                            <t t-if="msg.role === 'assistant'">
                                <button class="btn btn-sm btn-link text-muted p-0" title="Copy" t-on-click="() => this.copyMessage(msg.content)">
                                    <i class="fa fa-copy"/>
                                </button>
                            </t>
                        </div>
                        <div class="o_ai_msg_content">
                            <t t-out="msg.content"/>
                        </div>
                    </div>
                </t>
                <t t-if="state.isLoading">
                    <div class="o_ai_message o_ai_msg_assistant">
                        <div class="d-flex align-items-center gap-2 text-muted">
                            <i class="fa fa-circle-o-notch fa-spin"/>
                            <span>Thinking and executing tools...</span>
                        </div>
                    </div>
                </t>
            </div>
            <div class="o_ai_input_footer">
                <div class="o_ai_input_box">
                    <textarea 
                        rows="2" 
                        t-model="state.inputPrompt" 
                        t-on-keydown="onKeyDown" 
                        placeholder="Ask AI anything (e.g., 'Summarize open sales orders for this month')..."/>
                    <button class="btn btn-primary px-3" t-on-click="sendMessage" t-att-disabled="state.isLoading">
                        <i class="fa fa-paper-plane me-1"/> Send
                    </button>
                </div>
            </div>
        </Dialog>
    </t>
</templates>
