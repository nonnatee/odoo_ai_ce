<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Provider List View -->
    <record id="ai_ce_provider_view_list" model="ir.ui.view">
        <field name="name">ai_ce.provider.list</field>
        <field name="model">ai_ce.provider</field>
        <field name="arch" type="xml">
            <list string="AI Providers">
                <field name="priority" widget="handle"/>
                <field name="name"/>
                <field name="service"/>
                <field name="api_base"/>
                <field name="connection_status" widget="badge" decoration-success="connection_status == 'connected'" decoration-danger="connection_status == 'error'"/>
                <field name="last_checked"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Provider Form View -->
    <record id="ai_ce_provider_view_form" model="ir.ui.view">
        <field name="name">ai_ce.provider.form</field>
        <field name="model">ai_ce.provider</field>
        <field name="arch" type="xml">
            <form string="AI Provider Configuration">
                <header>
                    <button name="action_check_connection" string="Check Connection" type="object" class="btn-secondary"/>
                    <button name="%(action_ai_ce_fetch_model_wizard)d" string="Fetch Models" type="action" class="btn-primary" context="{'default_provider_id': id}"/>
                    <field name="connection_status" widget="statusbar" statusbar_visible="connected,error"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Local Ollama, OpenAI Production"/></h1>
                    </div>
                    <group>
                        <group string="Service Configuration">
                            <field name="service"/>
                            <field name="api_base" placeholder="http://localhost:11434/v1"/>
                            <field name="api_key" password="True"/>
                        </group>
                        <group string="Routing &amp; Routing Order">
                            <field name="priority"/>
                            <field name="active"/>
                            <field name="default_chat_model_id"/>
                            <field name="default_embedding_model_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Model Catalog" name="models">
                            <field name="model_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="model_use"/>
                                    <field name="context_window"/>
                                    <field name="supports_tools"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Fallback Providers" name="fallbacks">
                            <field name="fallback_provider_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="service"/>
                                    <field name="priority"/>
                                    <field name="connection_status" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Provider Action -->
    <record id="action_ai_ce_provider" model="ir.actions.act_window">
        <field name="name">AI Providers</field>
        <field name="res_model">ai_ce.provider</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Model Action -->
    <record id="action_ai_ce_model" model="ir.actions.act_window">
        <field name="name">AI Model Catalog</field>
        <field name="res_model">ai_ce.model</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Model List View -->
    <record id="ai_ce_model_view_list" model="ir.ui.view">
        <field name="name">ai_ce.model.list</field>
        <field name="model">ai_ce.model</field>
        <field name="arch" type="xml">
            <list string="AI Models">
                <field name="name"/>
                <field name="provider_id"/>
                <field name="model_use" widget="badge"/>
                <field name="context_window"/>
                <field name="supports_tools"/>
                <field name="active"/>
            </list>
        </field>
    </record>
</odoo>
