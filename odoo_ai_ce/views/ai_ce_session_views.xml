<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ai_ce_session_view_list" model="ir.ui.view">
        <field name="name">ai_ce.session.list</field>
        <field name="model">ai_ce.session</field>
        <field name="arch" type="xml">
            <list string="AI Conversation Sessions">
                <field name="name"/>
                <field name="agent_id"/>
                <field name="user_id"/>
                <field name="message_count"/>
                <field name="create_date"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="ai_ce_session_view_form" model="ir.ui.view">
        <field name="name">ai_ce.session.form</field>
        <field name="model">ai_ce.session</field>
        <field name="arch" type="xml">
            <form string="AI Conversation Session">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="agent_id"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="message_count"/>
                            <field name="create_date"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Conversation History" name="messages">
                            <field name="message_ids">
                                <list>
                                    <field name="create_date"/>
                                    <field name="role" widget="badge"/>
                                    <field name="content"/>
                                    <field name="tool_call_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ai_ce_session" model="ir.actions.act_window">
        <field name="name">Conversation Sessions</field>
        <field name="res_model">ai_ce.session</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
